{
  "name": "twitch-dlp",
  "version": "0.6.6",
  "description": "Download any Twitch VODs from the start during a live broadcast",
  "license": "MIT",
  "author": "DmitryScaletta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitryScaletta/twitch-dlp.git"
  },
  "bin": "twitch-dlp.js",
  "files": [
    "DOWNLOAD_PRIVATE_VIDEOS.md"
  ],
  "type": "module",
  "scripts": {
    "start": "node ./src/main.ts",
    "build": "pnpx rolldown src/main.ts --file twitch-dlp.js --platform node",
    "test": "node --experimental-transform-types --test **/*.test.ts",
    "test:watch": "node --experimental-transform-types --test --watch **/*.test.ts",
    "test:types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "twitch-gql-queries": "^0.1.25",
    "twitch-regex": "^0.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
